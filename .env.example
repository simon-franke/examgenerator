# Model used to write exams. It needs image input and tool calls.
EXAMGEN_PROVIDER=ollama
EXAMGEN_BASE_URL=
EXAMGEN_MODEL=
EXAMGEN_API_KEY=

# Embeddings
EXAMGEN_EMBEDDING_PROVIDER=ollama
EXAMGEN_EMBEDDING_MODEL=nomic-embed-text
EXAMGEN_EMBEDDING_DIM=768
EXAMGEN_EMBEDDING_BASE_URL=
EXAMGEN_EMBEDDING_API_KEY=

EXAMGEN_DATABASE_URL=postgres://postgres:examgen@localhost:5432/examgen?sslmode=disable

# Generation
EXAMGEN_MAX_TOKENS=8192
EXAMGEN_TEMPERATURE=0.4
EXAMGEN_MAX_TOOL_HOPS=24
EXAMGEN_REQUEST_TIMEOUT=20m

# Ingestion
EXAMGEN_CHUNK_SIZE=1000
EXAMGEN_CHUNK_OVERLAP=200

# Optional private Discord DM delivery (use a bot token, never a user token).
EXAMGEN_DISCORD_ENABLED=false
EXAMGEN_DISCORD_BOT_TOKEN=
EXAMGEN_DISCORD_USER_ID=
